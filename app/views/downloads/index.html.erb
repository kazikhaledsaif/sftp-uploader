<header class="bar">
  <div class="bar-inner">
    <span class="wordmark"><i class="ph-fill ph-popcorn"></i> Popcorn</span>
    <span class="bar-count"><span class="num" id="stat-active"><%= @active_downloads %></span> running</span>
  </div>
</header>

<main class="page">
  <% flash.each do |type, message| %>
    <div class="flash flash-<%= type %>" role="status"><%= message %></div>
  <% end %>

  <%= form_with(model: Download.new, local: false, class: 'composer', id: 'new-download-form') do |f| %>
    <div class="field">
      <label for="download_url">Link</label>
      <div class="with-action">
        <%= f.url_field :url, placeholder: 'https://example.com/file.mkv', class: 'input', required: true,
              inputmode: 'url', autocapitalize: 'off', autocorrect: 'off', spellcheck: false, autocomplete: 'off' %>
        <button type="button" class="inline-action" id="paste-url" hidden><i class="ph ph-clipboard-text"></i> Paste</button>
      </div>
    </div>

    <div class="field">
      <label for="download_filename"><span id="name-label">Name</span> <span class="label-note" id="name-note">folder and file</span></label>
      <%= f.text_field :filename, placeholder: 'Dangal (2016)', class: 'input', required: true,
            autocomplete: 'off', enterkeyhint: 'done' %>
    </div>

    <fieldset class="field">
      <legend>Save to</legend>
      <div class="segmented">
        <% @destinations.each_with_index do |(label, path), i| %>
          <label>
            <%= f.radio_button :destination_path, path, required: true, checked: i.zero?,
                  data: { tv: Destinations.tv?(path) } %>
            <span><%= label %></span>
          </label>
        <% end %>
      </div>
    </fieldset>

    <div class="tv-fields" id="tv-fields" hidden>
      <fieldset class="field">
        <legend>What is it?</legend>
        <div class="segmented">
          <label><input type="radio" name="download[kind]" value="season" checked><span>Whole season</span></label>
          <label><input type="radio" name="download[kind]" value="episode"><span>One episode</span></label>
        </div>
      </fieldset>

      <div class="field-row">
        <div class="field">
          <label for="download_season">Season</label>
          <input type="number" id="download_season" name="download[season]" class="input" min="0" max="99" value="1" inputmode="numeric">
        </div>
        <div class="field" data-kind="episode" hidden>
          <label for="download_episode">Episode</label>
          <input type="number" id="download_episode" name="download[episode]" class="input" min="1" max="999" inputmode="numeric">
        </div>
        <div class="field" data-kind="season">
          <label for="download_episode_count">Episodes <span class="label-note">optional</span></label>
          <input type="number" id="download_episode_count" name="download[episode_count]" class="input" min="1" max="999" inputmode="numeric" placeholder="e.g. 8">
        </div>
      </div>
    </div>

    <p class="form-error" id="form-error" role="alert" hidden></p>

    <button type="submit" class="primary" id="submit-download">Start download</button>
  <% end %>

  <div class="lists">
    <% if @downloads.empty? %>
      <div class="empty">
        <i class="ph ph-tray"></i>
        <p>Nothing here yet. Paste a link to start your first download.</p>
      </div>
    <% end %>

    <% if @running.any? %>
      <section aria-labelledby="running-title">
        <h2 class="list-title" id="running-title">Downloading</h2>
        <ul class="dl-list">
          <% @running.each do |download| %>
            <%= render 'download_card', download: download %>
          <% end %>
        </ul>
      </section>
    <% end %>

    <% if @history.any? %>
      <section aria-labelledby="history-title">
        <h2 class="list-title" id="history-title">History</h2>
        <ul class="dl-list">
          <% @history.each do |download| %>
            <%= render 'download_card', download: download %>
          <% end %>
        </ul>
      </section>
    <% end %>
  </div>
</main>

<script>
  // Live progress: poll /downloads/status while anything is running.
  (() => {
    const ACTIVE = ['pending', 'downloading', 'paused'];
    let timer = null;

    const hasActiveRows = () =>
      [...document.querySelectorAll('.dl')].some(r => ACTIVE.includes(r.dataset.status));

    // Don't reload under someone who is typing or has a sheet open.
    const busy = () => document.querySelector('dialog[open]') ||
      ['download_url', 'download_filename'].some(id => document.getElementById(id).value);

    async function poll() {
      try {
        const res = await fetch('/downloads/status', { headers: { 'Accept': 'application/json' } });
        if (!res.ok) return;
        const data = await res.json();
        document.getElementById('stat-active').textContent = data.active;

        for (const d of data.downloads) {
          const row = document.querySelector(`.dl[data-download-id="${d.id}"]`);
          if (!row) continue;
          if (row.dataset.status !== d.status) {
            if (!busy()) { window.location.reload(); return; }
            continue;
          }
          const bar = row.querySelector('.dl-bar');
          if (bar) { bar.firstElementChild.style.width = `${d.progress}%`; bar.setAttribute('aria-valuenow', d.progress); }
          const set = (sel, text) => { const el = row.querySelector(sel); if (el) el.textContent = text; };
          set('.dl-pct', `${d.progress}%`);
          set('.dl-speed', d.speed || '');
          set('.dl-eta', d.eta ? `${d.eta} left` : '');
        }
      } catch (e) {
        console.warn('Status poll failed', e);
      }
      if (!hasActiveRows()) { clearInterval(timer); timer = null; }
    }

    document.addEventListener('DOMContentLoaded', () => {
      if (hasActiveRows()) timer = setInterval(poll, 2000);
    });
  })();

  // Bottom sheets for each row's extra actions.
  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-sheet]').forEach(btn => btn.addEventListener('click', () => {
      document.getElementById(btn.dataset.sheet).showModal();
    }));
    document.querySelectorAll('dialog.sheet').forEach(sheet => {
      sheet.querySelector('[data-close]').addEventListener('click', () => sheet.close());
      // Tap on the dimmed backdrop closes the sheet.
      sheet.addEventListener('click', e => { if (e.target === sheet) sheet.close(); });
    });
  });

  // New download form
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('new-download-form');
    const url = document.getElementById('download_url');
    const name = document.getElementById('download_filename');
    const errorBox = document.getElementById('form-error');
    const submit = document.getElementById('submit-download');
    const pasteBtn = document.getElementById('paste-url');
    const DEST_KEY = 'downloader.destination';

    // Remember the last destination picked.
    try {
      const saved = localStorage.getItem(DEST_KEY);
      const radio = saved && form.querySelector(`input[name="download[destination_path]"][value="${CSS.escape(saved)}"]`);
      if (radio) radio.checked = true;
    } catch (_) {}

    // TV fields: shown only when a TV destination is picked.
    const tvFields = document.getElementById('tv-fields');
    const destRadios = [...form.querySelectorAll('input[name="download[destination_path]"]')];
    const kindRadios = [...form.querySelectorAll('input[name="download[kind]"]')];
    const season = document.getElementById('download_season');
    const episode = document.getElementById('download_episode');
    const episodeCount = document.getElementById('download_episode_count');
    const isTv = () => destRadios.find(r => r.checked)?.dataset.tv === 'true';
    const kind = () => isTv() ? kindRadios.find(r => r.checked).value : 'movie';

    const syncTvFields = () => {
      tvFields.hidden = !isTv();
      form.querySelectorAll('[data-kind]').forEach(el => { el.hidden = el.dataset.kind !== kind(); });
      season.required = isTv();
      episode.required = kind() === 'episode';
      document.getElementById('name-label').textContent = isTv() ? 'Show name' : 'Name';
      document.getElementById('name-note').textContent = isTv() ? '' : 'folder and file';
      name.placeholder = isTv() ? 'Panchayat (2020)' : 'Dangal (2016)';
    };
    [...destRadios, ...kindRadios].forEach(r => r.addEventListener('change', syncTvFields));

    // "Dangal.2016.1080p.WEB" -> "Dangal (2016)"; "Some_Show" -> "Some Show"
    const tidy = (text) => {
      const t = text.replace(/[._]+/g, ' ').replace(/\s+/g, ' ').trim();
      const y = t.match(/^(.*?)[\s(\[-]*((?:19|20)\d{2})(?:[\s)\]-]|$)/);
      return y && y[1].trim() ? `${y[1].trim()} (${y[2]})` : t;
    };

    // Read the link's file name: fills the name and, for "Show.S03E02" or
    // "Show.S03" / "Show Season 3", switches to TV with season/episode set.
    const readLink = () => {
      let base;
      try {
        base = decodeURIComponent(new URL(url.value.trim()).pathname.split('/').pop() || '');
      } catch (_) { return; }
      base = base.replace(/\.[a-z0-9]{2,4}$/i, '');
      const tv = base.match(/^(.*?)[\s._-]+S(\d{1,2})(?:[\s._-]?E(\d{1,3}))?(?![a-z0-9])/i) ||
                 base.match(/^(.*?)[\s._-]+Season[\s._-]?(\d{1,2})(?![0-9])/i);
      if (tv) {
        if (!isTv()) { const r = destRadios.find(r => r.dataset.tv === 'true'); if (r) r.checked = true; }
        season.value = parseInt(tv[2], 10);
        const ep = tv[3] ? parseInt(tv[3], 10) : null;
        kindRadios.find(r => r.value === (ep ? 'episode' : 'season')).checked = true;
        if (ep) episode.value = ep;
        if (!name.value.trim()) name.value = tidy(tv[1]);
      } else if (!name.value.trim() && base) {
        name.value = tidy(base);
      }
      syncTvFields();
    };
    const suggestName = readLink;
    syncTvFields();
    url.addEventListener('change', suggestName);
    url.addEventListener('paste', () => setTimeout(suggestName, 0));

    // Paste button: only where the browser allows reading the clipboard (HTTPS or localhost).
    if (navigator.clipboard && navigator.clipboard.readText && window.isSecureContext) {
      pasteBtn.hidden = false;
      pasteBtn.addEventListener('click', async () => {
        try {
          url.value = (await navigator.clipboard.readText()).trim();
          suggestName();
          name.focus();
        } catch (_) { url.focus(); }
      });
    }

    const showError = msg => { errorBox.textContent = msg; errorBox.hidden = false; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorBox.hidden = true;

      const formData = new FormData(form);
      const destination = formData.get('download[destination_path]');
      try { localStorage.setItem(DEST_KEY, destination); } catch (_) {}

      submit.disabled = true;
      submit.textContent = 'Starting...';
      try {
        const response = await fetch('/downloads', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json',
            'X-CSRF-Token': document.querySelector('[name="csrf-token"]').content
          },
          body: JSON.stringify({
            download: {
              url: formData.get('download[url]'),
              filename: formData.get('download[filename]'),
              destination_path: destination,
              kind: kind(),
              season: isTv() ? season.value : null,
              episode: kind() === 'episode' ? episode.value : null,
              episode_count: kind() === 'season' ? episodeCount.value : null
            }
          })
        });

        if (response.ok) {
          window.location.reload();
          return;
        }
        const error = await response.json().catch(() => ({}));
        showError(error.errors || `The download could not be started (error ${response.status}).`);
      } catch (_) {
        showError('Could not reach the server. Check your connection and try again.');
      }
      submit.disabled = false;
      submit.textContent = 'Start download';
    });
  });
</script>
