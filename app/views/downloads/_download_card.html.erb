<% active = download.pending? || download.downloading? || download.paused? %>
<% sheet_id = "sheet-#{download.id}" %>
<li class="dl" data-download-id="<%= download.id %>" data-status="<%= download.status %>">
  <div class="dl-head">
    <h3 class="dl-name">
      <%= display_name(download) %>
      <% if (ep = episode_label(download)) %><span class="dl-ep"><%= ep %></span><% end %>
    </h3>

    <% if download.can_pause? %>
      <%= button_to pause_download_path(download), method: :post, class: 'icon-btn', form: { data: { turbo: false } },
            aria: { label: "Pause #{display_name(download)}" } do %><i class="ph ph-pause"></i><% end %>
    <% elsif download.can_resume? %>
      <%= button_to resume_download_path(download), method: :post, class: 'icon-btn icon-btn-accent', form: { data: { turbo: false } },
            aria: { label: "#{download.failed? ? 'Retry' : 'Resume'} #{display_name(download)}" } do %><i class="ph <%= download.failed? ? 'ph-arrow-clockwise' : 'ph-play' %>"></i><% end %>
    <% end %>

    <button type="button" class="icon-btn" data-sheet="<%= sheet_id %>" aria-label="More for <%= display_name(download) %>">
      <i class="ph ph-dots-three"></i>
    </button>
  </div>

  <% if active %>
    <div class="dl-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= download.progress_percentage %>">
      <i style="width: <%= download.progress_percentage %>%"></i>
    </div>
    <div class="dl-meta">
      <span class="dl-status"><%= status_label(download) %></span>
      <span class="num dl-pct"><%= download.progress_percentage %>%</span>
      <span class="num dl-speed"><%= download.formatted_speed %></span>
      <span class="num dl-eta"><%= download.formatted_eta && "#{download.formatted_eta} left" %></span>
      <span class="dl-where"><%= destination_label(download) %></span>
    </div>
  <% else %>
    <div class="dl-meta">
      <span class="dl-status"><%= status_label(download) %></span>
      <span class="dl-where"><%= destination_label(download) %></span>
      <span class="num dl-size"><%= download.formatted_file_size unless download.file_size.nil? %></span>
      <span class="dl-when"><%= time_ago_in_words(download.created_at) %> ago</span>
    </div>
  <% end %>

  <% if download.error_message.present? %>
    <p class="dl-note"><%= friendly_error(download.error_message) %></p>
  <% end %>

  <dialog class="sheet" id="<%= sheet_id %>" aria-labelledby="<%= sheet_id %>-title">
    <div class="sheet-body">
      <h4 class="sheet-title" id="<%= sheet_id %>-title"><%= display_name(download) %></h4>
      <p class="sheet-path num"><%= download.folder_path %></p>

      <div class="sheet-actions">
        <% if download.can_cancel? %>
          <%= button_to cancel_download_path(download), method: :post, form: { data: { turbo: false } } do %>
            <i class="ph ph-stop-circle"></i> Cancel download
          <% end %>
        <% end %>
        <%= button_to download_path(download), method: :delete,
              form: { data: { turbo: false }, onsubmit: "return confirm('Remove this from the list? The file stays on the server.')" } do %>
          <i class="ph ph-list-dashes"></i> Remove from list
        <% end %>
        <%= button_to destroy_file_download_path(download), method: :delete, class: 'danger',
              form: { data: { turbo: false }, onsubmit: "return confirm('Delete this file and its folder from the server? This cannot be undone.')" } do %>
          <i class="ph ph-trash"></i> Delete file and folder
        <% end %>
      </div>

      <button type="button" class="sheet-close" data-close>Close</button>
    </div>
  </dialog>
</li>
