# Copy this file to .env and fill in real values. Never commit .env.

# Login for the web UI (required)
AUTH_USERNAME=admin
AUTH_PASSWORD=change_me

# Generate with: openssl rand -hex 64
SECRET_KEY_BASE=change_me

# Hostnames allowed to reach the app, comma-separated. Empty = any (OK on a private LAN).
APP_HOSTS=

# Folder on this machine that holds your media folders. Mounted in the containers as /data.
MEDIA_ROOT=/mnt/storage

# "Save to" choices: "Label=/data/<folder>,..." (folders inside MEDIA_ROOT)
# Empty = Movies=/data/Movies,TV Series=/data/TV,Downloads=/data/Downloads
DOWNLOAD_DESTINATIONS=

# Shared secret between the app and aria2. Generate with: openssl rand -hex 24
ARIA2_RPC_SECRET=change_me
# Connections per file (1-16). More = faster on servers that limit speed per connection.
ARIA2_CONNECTIONS=16
# How many downloads run at the same time; the rest wait in the queue.
ARIA2_MAX_CONCURRENT=5
# Speed cap used only until Popcorn starts; then the "Download speed" buttons
# on the Downloads page (Full / Balanced / Light) decide.
ARIA2_SPEED_LIMIT=0
# RAM used to batch disk writes (helps slow HDDs)
ARIA2_DISK_CACHE=64M
# falloc for local disks (ext4/xfs/btrfs); use none if MEDIA_ROOT is a Samba/NFS mount
ARIA2_FILE_ALLOCATION=falloc

# Port the web UI is published on
APP_PORT=9000

# Watchlist artwork and search: free key from https://www.themoviedb.org/settings/api
# (the "API Key" or the "API Read Access Token" both work). Empty = add titles by name only.
TMDB_API_KEY=
# Optional: IMDb / Rotten Tomatoes / Metacritic scores. Free key: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=

# Your time zone, for "watched on" dates (e.g. Asia/Kolkata, Asia/Dhaka)
TIME_ZONE=UTC

# Daily database backups (watchlist, diary, history)
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14
